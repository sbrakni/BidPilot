{
  "name": "@bidpilot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force --skip-seed && tsx src/seed.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "lint": "echo \"no JS linter configured yet (see docs/STATUS.md)\""
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
