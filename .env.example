# BidPilot local configuration. Copy to `.env` and adjust.
# No real secret ever belongs in this file or in git (SPEC §16 Security).

# ---------------------------------------------------------------- core
NODE_ENV=development
APP_NAME=BidPilot
# Rename is a config constant, not a code change (SPEC §24.1).
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ---------------------------------------------------------------- postgres
# `docker compose up` credentials. Migrations are owned by packages/db (Prisma).
DATABASE_URL=postgresql://bidpilot:bidpilot@localhost:5432/bidpilot?schema=public
# Application role used at runtime: NOT the owner, so Postgres RLS is enforced
# rather than bypassed (see packages/db/prisma/migrations - SPEC §17.6).
DATABASE_APP_URL=postgresql://bidpilot_app:bidpilot_app@localhost:5432/bidpilot?schema=public
DATABASE_APP_PASSWORD=bidpilot_app
# The web app's Auth.js adapter. Reaches the four authentication tables and nothing else, which
# is what keeps "web ↔ api only" (§17.2) true while Auth.js has its adapter (ADR-0015).
DATABASE_AUTH_URL=postgresql://bidpilot_auth:bidpilot_auth@localhost:5432/bidpilot?schema=public
DATABASE_AUTH_PASSWORD=bidpilot_auth

# ---------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_BUCKET=bidpilot-dev
S3_ACCESS_KEY_ID=bidpilot
S3_SECRET_ACCESS_KEY=bidpilot-dev-secret
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- email
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="BidPilot <no-reply@bidpilot.example>"
# Inbound connector (SPEC §6.5): every org gets sources+{org}@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_DOMAIN=in.bidpilot.example
INBOUND_EMAIL_WEBHOOK_SECRET=dev-inbound-secret

# ---------------------------------------------------------------- auth
# Auth.js (SPEC §17.1). Generate a real secret with `openssl rand -base64 32`.
AUTH_SECRET=dev-only-change-me
AUTH_URL=http://localhost:3000
# Magic-link delivery. Mailpit catches these locally; see http://localhost:8025.
EMAIL_SERVER=smtp://localhost:1025
# OAuth is optional: each provider's button appears only when its credentials are set, so a
# deployment without them still signs people in by magic link (§17.1).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ---------------------------------------------------------------- LLM gateway (packages/ai)
# All model access goes through the gateway; nothing calls a provider directly (SPEC §17.4).
ANTHROPIC_API_KEY=
# Model tiers S/M/L are resolved by config, never hardcoded at call sites.
LLM_MODEL_TIER_S=claude-haiku-4-5-20251001
LLM_MODEL_TIER_M=claude-sonnet-5
LLM_MODEL_TIER_L=claude-opus-5
LLM_MAX_COST_CENTS_PER_ANALYSIS=300
EMBEDDING_MODEL=voyage-multilingual-2
EMBEDDING_DIM=1024

# ---------------------------------------------------------------- ingestion
INGESTION_USER_AGENT=BidPilotBot/1.0 (+https://bidpilot.example/bot)
# Default politeness ceiling; per-source overrides live in the sources table (SPEC §16).
INGESTION_MAX_RPS_PER_SOURCE=1
INGESTION_ENABLED_SOURCES=eu-ted,fr-boamp

# ---------------------------------------------------------------- billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
