{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      // Turbo hides the ambient environment by default. The suites that prove tenant
      // isolation need both connections: the owner to set fixtures up, and the non-owner
      // application role that RLS actually applies to.
      "env": ["DATABASE_URL", "DATABASE_APP_URL", "API_PORT"],
      // Not cached: these suites assert against live database state, so a cached "pass"
      // would be meaningless. Serialisation across packages is set with `--concurrency=1`
      // in the root `test` script, since they share one Postgres.
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
